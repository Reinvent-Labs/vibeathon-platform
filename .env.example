# Application
NEXT_PUBLIC_APP_URL=https://vibeathon.example.com
APP_PORT=3000
NODE_ENV=production
AUTH_REQUIRED=true
SESSION_SECRET=replace-with-at-least-32-random-characters

# PostgreSQL (Docker Compose)
POSTGRES_DB=vibeathon
POSTGRES_USER=vibeathon
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://vibeathon:replace-with-a-strong-database-password@db:5432/vibeathon

# Initial local admin (used by npm run db:seed)
ADMIN_EMAIL=admin@vibeathonci.com
ADMIN_INITIAL_PASSWORD=replace-on-first-deployment

# PaiementPro
PAIEMENTPRO_MERCHANT_ID=PP-F92248
PAIEMENTPRO_WEBHOOK_SECRET=replace-with-the-shared-webhook-secret
PAIEMENTPRO_DEMO_MODE=false

# SMTP email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=VIBEATHON 2026 <contact@vibeathonci.com>

# Wassenger WhatsApp (optional)
WASSENGER_API_KEY=
WASSENGER_DEVICE_ID=
