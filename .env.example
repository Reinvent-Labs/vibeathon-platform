# Application
DOMAIN=www.vibeathonci.com
NEXT_PUBLIC_APP_URL=https://www.vibeathonci.com
APP_PORT=3000
NODE_ENV=production
SESSION_SECRET=replace-with-at-least-32-random-characters

# PostgreSQL (Docker Compose)
POSTGRES_DB=vibeathon
POSTGRES_USER=vibeathon
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://vibeathon:replace-with-a-strong-database-password@db:5432/vibeathon

# Initial local admin (used by npm run db:seed)
ADMIN_EMAIL=admin@vibeathonci.com
ADMIN_INITIAL_PASSWORD=replace-on-first-deployment

# PaiementPro
PAIEMENTPRO_MERCHANT_ID=PP-F92248
PAIEMENTPRO_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
# Development only. Production always rejects demo confirmation.
PAIEMENTPRO_DEMO_MODE=false

# SMTP email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=VIBEATHON 2026 <contact@vibeathonci.com>

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_RESULTS=vibeathon_resultats_disponibles
WHATSAPP_TEMPLATE_ACCEPTED=vibeathon_dossier_accepte
WHATSAPP_TEMPLATE_PAYMENT_REMINDER=vibeathon_rappel_paiement
WHATSAPP_TEMPLATE_PAYMENT=vibeathon_paiement_confirme
WHATSAPP_TEMPLATE_BOOTCAMP=vibeathon_infos_bootcamp
WHATSAPP_TEMPLATE_EVENT_REMINDER=vibeathon_rappel_event
WHATSAPP_TEMPLATE_TEAM=vibeathon_equipe_confirmee

# ── AI Evaluation (OpenRouter) ───────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
