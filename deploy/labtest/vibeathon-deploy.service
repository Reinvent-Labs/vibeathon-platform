[Unit]
Description=Deploy the latest VIBEATHON platform revision
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/user/vibeathon-platform
Environment=APP_DIR=/home/user/vibeathon-platform
Environment=DEPLOY_BRANCH=main
ExecStart=/home/user/vibeathon-platform/deploy/labtest/deploy.sh
