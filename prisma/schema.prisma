generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ParticipantStatus {
  PENDING
  WAITLIST
  SELECTED
  REJECTED
  PAID
  CONFIRMED
  CHECKED_IN
}

enum ParticipantCategory {
  HACKATHON
  VISITEUR
  FORMATION_ADULTE
  FORMATION_KIDS
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  JURY
  SCANNER
}

enum ScanResult {
  ACCEPTED
  DUPLICATE
  REJECTED
}

enum MessageChannel {
  EMAIL
  WHATSAPP
}

enum MessageStatus {
  QUEUED
  SENT
  FAILED
}

model Competition {
  id                  String       @id @default(cuid())
  name                String
  slug                String       @unique
  eventDate           DateTime
  venue               String
  participationFee   Int          @default(20000)
  capacity            Int          @default(400)
  competitorCapacity  Int          @default(100)
  registrationOpen   Boolean      @default(true)
  phases              Phase[]
  sessions            Session[]
  participants        Participant[]
  teams               Team[]
  criteria            JudgingCriteria[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model Phase {
  id             String      @id @default(cuid())
  competitionId  String
  name           String
  order          Int
  active         Boolean     @default(false)
  startsAt       DateTime?
  endsAt         DateTime?
  competition    Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@unique([competitionId, order])
}

model Session {
  id             String       @id @default(cuid())
  competitionId  String
  name           String
  description    String?
  location       String?
  startsAt       DateTime?
  endsAt         DateTime?
  active         Boolean      @default(false)
  archivedAt     DateTime?
  allowedCategories ParticipantCategory[] @default([HACKATHON, VISITEUR, FORMATION_ADULTE, FORMATION_KIDS])
  competition    Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  scans           ScanRecord[]

  @@index([competitionId, archivedAt, startsAt])
}

model Participant {
  id             String             @id @default(cuid())
  competitionId  String
  reference      String             @unique
  category       ParticipantCategory @default(HACKATHON)
  fullName       String
  email          String
  phone          String
  city           String             @default("")
  profile        String             @default("")
  motivation     String             @default("")
  source         String?
  age            String?
  gender         String?
  profession     String?
  technicalLevel String?
  aiExperience   String?
  aiTools        String?
  otherAiTools   String?
  registrationMode String?
  proposedTeamName String?
  preferredDomain String?
  fullProgramAvailable Boolean?
  incubationCommitment Boolean?
  conditionsAccepted Boolean @default(false)
  declarationAccepted Boolean @default(false)
  rawApplication Json?
  importedAt     DateTime?
  isTest         Boolean            @default(false)
  status         ParticipantStatus  @default(PENDING)
  qrCode         String             @unique
  paidAt         DateTime?
  confirmedAt    DateTime?
  teamId         String?
  competition    Competition        @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  team           Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  scans          ScanRecord[]
  emailLogs      EmailLog[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([competitionId, email])
  @@index([competitionId, status])
}

model ScanRecord {
  id             String       @id @default(cuid())
  participantId  String?
  sessionId      String
  scannedById    String?
  qrCode         String
  acceptedKey    String?      @unique
  result         ScanResult
  note           String?
  participant    Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  session        Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  scannedBy      AdminUser?   @relation(fields: [scannedById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([sessionId, qrCode])
}

model Team {
  id              String         @id @default(cuid())
  competitionId   String
  name            String
  tableNumber     String?
  problem         String
  demoUrl         String?
  repositoryUrl   String?
  isFinalist      Boolean        @default(false)
  rank            Int?
  competition     Competition    @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  members         Participant[]
  scores          JuryScore[]
  aiEvaluation    AIEvaluation?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([competitionId, name])
}

model JudgingCriteria {
  id             String       @id @default(cuid())
  competitionId  String
  name           String
  key            String
  weight         Int
  order          Int
  competition    Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  scores         JuryScore[]

  @@unique([competitionId, key])
}

model JuryScore {
  id          String            @id @default(cuid())
  teamId      String
  criteriaId  String
  juryId      String
  score       Int
  comment     String?
  lockedAt    DateTime?
  team        Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  criteria    JudgingCriteria   @relation(fields: [criteriaId], references: [id], onDelete: Cascade)
  jury        AdminUser         @relation(fields: [juryId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([teamId, criteriaId, juryId])
}

model AIEvaluation {
  id          String   @id @default(cuid())
  teamId      String   @unique
  provider    String?
  model       String?
  score       Float?
  summary     String?
  raw         Json?
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminUser {
  id             String       @id @default(cuid())
  authUserId     String       @unique
  email          String       @unique
  fullName       String
  role           AdminRole
  passwordHash   String?
  mustChangePassword Boolean   @default(false)
  active         Boolean      @default(true)
  lastLoginAt    DateTime?
  scans          ScanRecord[]
  scores         JuryScore[]
  auditLogs      AuditLog[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model AuditLog {
  id          String     @id @default(cuid())
  actorId     String?
  action      String
  entityType  String?
  entityId    String?
  ipAddress   String?
  metadata    Json?
  actor       AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
}

model SiteContent {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model SitePage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @default("")
  content     String   @default("") // HTML from TipTap
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmailTemplate {
  slug         String   @id
  label        String
  subject      String
  eyebrow      String
  title        String
  introduction String
  bodyHtml     String   @default("")
  actionLabel  String   @default("")
  updatedAt    DateTime @updatedAt
}

model MediaAsset {
  id        String   @id @default(cuid())
  filename  String
  path      String
  size      Int
  createdAt DateTime @default(now())
}

model EmailLog {
  id             String          @id @default(cuid())
  participantId  String?
  channel        MessageChannel
  template       String
  recipient      String
  subject        String?
  status         MessageStatus   @default(QUEUED)
  providerId     String?
  error          String?
  participant    Participant?    @relation(fields: [participantId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
}
